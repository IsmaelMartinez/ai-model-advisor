{
  "name": "ai-model-advisor",
  "version": "0.1.0",
  "description": "An open source assistant to help you choose the most environmentally efficient AI model for your task",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "update-models": "node scripts/update-models/cli.js",
    "update-models:dry-run": "node scripts/update-models/cli.js --dry-run",
    "precompute-embeddings": "node scripts/precompute-embeddings.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "ajv": "^8.20.0",
    "svelte": "^5.57.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "onnxruntime-node": {
      "adm-zip": "^0.6.0"
    },
    "@huggingface/transformers": {
      "sharp": "^0.35.0"
    }
  },
  "keywords": [
    "ai",
    "ml",
    "model-selection",
    "pwa",
    "offline",
    "svelte"
  ],
  "author": "AI Model Advisor Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ismaelmartinez/ai-model-advisor.git"
  },
  "engines": {
    "node": "^22.17.0 || ^24.0.0 || >=26.0.0"
  }
}
