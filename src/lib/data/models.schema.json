{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Model Advisor models.json",
  "description": "Flat list of models. Tier and environmental score are not stored: they are derived from sizeMB when the data is loaded.",
  "type": "object",
  "required": ["schemaVersion", "lastUpdated", "models"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 2 },
    "lastUpdated": { "$ref": "#/definitions/isoDate" },
    "models": { "type": "array", "items": { "$ref": "#/definitions/model" } }
  },
  "definitions": {
    "isoDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "model": {
      "type": "object",
      "required": ["id", "name", "huggingFaceId", "description", "sizeMB", "accuracy", "tasks", "deploymentOptions", "frameworks", "lastUpdated"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "huggingFaceId": {
          "description": "Hub repository id; placeholder ids are rejected",
          "type": "string",
          "pattern": "^(?!placeholder/)[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)?$"
        },
        "browserModelId": {
          "description": "ONNX mirror to load in the browser when huggingFaceId has no ONNX weights",
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
        },
        "description": { "type": "string" },
        "sizeMB": { "type": "number", "exclusiveMinimum": 0 },
        "accuracy": {
          "description": "null when unknown; never estimated",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["metric", "value", "source"],
              "additionalProperties": false,
              "properties": {
                "metric": { "type": "string", "minLength": 1 },
                "value": { "type": "number", "minimum": 0, "maximum": 1 },
                "source": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["category", "subcategory"],
            "additionalProperties": false,
            "properties": {
              "category": { "enum": ["computer_vision", "natural_language_processing", "speech_processing", "time_series"] },
              "subcategory": { "type": "string", "minLength": 1 }
            }
          }
        },
        "specialization": { "type": "string" },
        "deploymentOptions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["browser", "mobile", "edge", "cloud", "server"] }
        },
        "frameworks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["PyTorch", "TensorFlow", "Transformers", "Transformers.js", "ONNX", "scikit-learn", "TensorFlow.js"] }
        },
        "lastUpdated": { "$ref": "#/definitions/isoDate" },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "browser": {
              "type": "object",
              "required": ["framework", "backend", "tested"],
              "additionalProperties": false,
              "properties": {
                "framework": { "enum": ["transformers.js", "onnx-runtime-web"] },
                "backend": { "type": "array", "items": { "enum": ["wasm", "webgpu"] } },
                "tested": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
